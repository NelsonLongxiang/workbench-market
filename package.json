{
  "name": "workbench-market",
  "private": true,
  "version": "0.1.0",
  "description": "管理 web 工作台的框架——聚合连接各端口服务开放的多类型 AI 工作台（SQLite + React antd）",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter server start",
    "check": "pnpm --filter web typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.7",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@nelsonlongxiang/dsh-open-a2a-net": "^0.6.25"
  }
}
