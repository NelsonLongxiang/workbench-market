{
 "doc": "待属主看板的用例表：前端 web/src/owner-pending.ts 和服务端 server/src/owner-pending.ts 跑同一份（scripts/owner-pending-unit.mjs）。args 里的 null 在 parseConfig 上表示「没有这个变量」（undefined）。expect 是两边都必须逐字段相同的结果。",
 "cases": [
  {
   "name": "按路径找到唯一看板台（忽略主机与末尾斜杠）",
   "fn": "findBoardWorkbench",
   "args": [
    [
     {
      "id": 3,
      "url": "http://other/"
     },
     {
      "id": 7,
      "url": "http://board.example:9800/owner-pending/"
     }
    ],
    "http://market.example:9800"
   ],
   "expect": {
    "id": 7
   }
  },
  {
   "name": "相对地址也认",
   "fn": "findBoardWorkbench",
   "args": [
    [
     {
      "id": 5,
      "url": "/owner-pending"
     }
    ],
    "http://market.example:9800"
   ],
   "expect": {
    "id": 5
   }
  },
  {
   "name": "没有看板台报错",
   "fn": "findBoardWorkbench",
   "args": [
    [
     {
      "id": 3,
      "url": "http://x/owner-pending-old"
     }
    ],
    "http://market.example:9800"
   ],
   "expect": {
    "error": "还没有登记看板台：请登记一张外部台卡片，地址填本站的 /owner-pending"
   }
  },
  {
   "name": "两张看板台报错并点名 id",
   "fn": "findBoardWorkbench",
   "args": [
    [
     {
      "id": 1,
      "url": "/owner-pending"
     },
     {
      "id": 2,
      "url": "http://y/owner-pending"
     }
    ],
    "http://market.example:9800"
   ],
   "expect": {
    "error": "登记了 2 张看板台卡片（id 1、2），请删到只剩一张"
   }
  },
  {
   "name": "坏 URL 不抛",
   "fn": "findBoardWorkbench",
   "args": [
    [
     {
      "id": 1,
      "url": "http://[bad"
     }
    ],
    "http://market.example:9800"
   ],
