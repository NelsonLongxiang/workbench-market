<mxCell id="sop-acl" value="受控SQLite ACL：run→target/version/owner-assignee/manifest SHA/ACLrev；可信bind尚未接运营迁移；新保存revision+原JSON摘要CAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="310" height="100" as="geometry"/></mxCell>
<mxCell id="sop-shell" value="可信壳：only shell能力300s硬过期；固定save端点、精确Origin/Host/market面；schema校验400ms节流；409/失败不冒saved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="810" y="160" width="310" height="100" as="geometry"/></mxCell>
<mxCell id="sop-frame" value="Opaque frame：allow-scripts，无same-origin；CSP禁网络；READY/INIT/CHANGE/VALIDATE/COLLECT/VALUES/LOCK/TEARDOWN；UPLOAD File/Blob→壳；无cap/身份/finish自报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="810" y="370" width="310" height="120" as="geometry"/></mxCell>
<mxCell id="sop-save" value="未挂载保存router→service：能力与fresh viewer再核，run/step/version/ACL/finished校验；BEGIN IMMEDIATE→expected revision+data SHA→COMMIT或ROLLBACK；旧链写后摘要不符409；人工COLLECT→finish核全schema/对象→事务finished+撤cap→LOCK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="310" height="120" as="geometry"/></mxCell>
<mxCell id="sop-limits" value="证据：内存SQLite，合成请求实际Express parser，序列化双端VM，Chromium拦截+stdio桥真实service；零TCP；不证明HTTP运输/现网Odoo/历史run迁移/跨worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="1070" height="100" as="geometry"/></mxCell>
<mxCell id="sop-e1" edge="1" parent="1" source="sop-identity" target="sop-acl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sop-e2" edge="1" parent="1" source="sop-acl" target="sop-shell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sop-e3" value="bound MessageChannel；nonce/双向seq" edge="1" parent="1" source="sop-shell" target="sop-frame"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sop-e4" value="固定端点+自定义头，cap不进frame" edge="1" parent="1" source="sop-shell" target="sop-save"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram><diagram id="sop-state-337-338" name="历史记录 · #337/#338 SOP状态候选"><mxGraphModel page="1" pageWidth="1300" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notice" value="候选实现 #337/#338；未合并/未部署&#xa;SQLite持久真源；30秒目标不等每次热写fsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1100" height="70" as="geometry"/></mxCell><mxCell id="api" value="REST / MCP / A2A note&#xa;唯一SOP状态链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="240" height="90" as="geometry"/></mxCell><mxCell id="queue" value="按run ID串行&#xa;保存 / 读取 / finish / note&#xa;不同run可并行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="290" height="110" as="geometry"/></mxCell><mxCell id="redis" value="Redis v2原子快照 + SQLite checkpoint指纹&#xa;冷读/finish只用匹配revision的热态&#xa;旧/部分/过期缓存miss；active仅提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="300" height="110" as="geometry"/></mxCell><mxCell id="pending" value="已确认待落盘数据 + 真实截止定时器&#xa;后续保存不延期；timer失败保留重试&#xa;同步拒绝还原此前已确认快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="310" height="100" as="geometry"/></mxCell><mxCell id="db" value="SQLite sop_runs 真源 + cache_revision&#xa;data/status更新触发器递增（含同值）&#xa;finish先写成功；task-center永远SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="300" height="100" as="geometry"/></mxCell><mxCell id="active" value="active = SQLite running元数据&#xa;含未保存/task-center&#xa;不信不完整/失效缓存索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="300" height="100" as="geometry"/></mxCell><mxCell id="shutdown" value="Graceful close：停接请求 → 排run队列 → flush → db.close&#xa;失败/超时非零退出；强杀/双故障不保证零丢失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="650" height="100" as="geometry"/></mxCell><mxCell id="evidence" value="证据边界：真实index + 新合成SQLite + 内存Redis + 31.1秒静置；虚拟时钟unit&#xa;不接生产Redis/DB，不测跨worker/强杀排空；现网clean-r1不动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="840" width="1150" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" edge="1" parent="1" source="api" target="queue" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="热态" edge="1" parent="1" source="queue" target="redis" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="已确认快照" edge="1" parent="1" source="queue" target="pending" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="30s截止 / 降级立即 / note立即" edge="1" parent="1" source="pending" target="db" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="完整集合" edge="1" parent="1" source="db" target="active" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="排空flush" edge="1" parent="1" source="shutdown" target="pending" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>