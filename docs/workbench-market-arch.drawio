ight="65" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;待完成的整合边界&lt;/b&gt;&lt;br&gt;不同数据源的成果不能互相替代" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;spacing=10;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1020" y="145" width="360" height="65" as="geometry"/></mxCell><mxCell id="own" value="&lt;b&gt;工作台自身持久层&lt;/b&gt;&lt;br&gt;registry / apps / SOP / app_data&lt;br&gt;固定源码仍为 SQLite&lt;br&gt;LC / YGL 切 PG 不等其已迁" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="360" height="140" as="geometry"/></mxCell><mxCell id="current-source" value="&lt;b&gt;主线内置 ygl 待办来源&lt;/b&gt;&lt;br&gt;专用 YGL_HOME + CLI 读取&lt;br&gt;授权与来源故障边界单独核&lt;br&gt;不是 PG 同步完成的证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="360" height="140" as="geometry"/></mxCell><mxCell id="goal" value="&lt;b&gt;PG 唯一写入源目标&lt;/b&gt;&lt;br&gt;临时空 SQLite 上线已取消&lt;br&gt;自身库迁移范围须单列&lt;br&gt;SSO 单票据至多消费一次仍须保留" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="360" height="145" as="geometry"/></mxCell><mxCell id="mixed" value="&lt;b&gt;同一 Workbench 候选进程&lt;/b&gt;&lt;br&gt;WB 07b8989 + YGL a9f6ae4&lt;br&gt;另加 ea64cd4 的 portal/helper&lt;br&gt;13/13 HTTP；18/18 含真实 Chromium&lt;br&gt;报告来自原执行节点，不是本席复跑" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="360" height="170" as="geometry"/></mxCell><mxCell id="temp-pg" value="&lt;b&gt;真实临时 PostgreSQL 15&lt;/b&gt;&lt;br&gt;合成任务：权限 / 故障隔离&lt;br&gt;内部网络，无生产挂载" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;shape=cylinder3;boundedLbl=1;size=15;" vertex="1" parent="1"><mxGeometry x="540" y="520" width="360" height="125" as="geometry"/></mxCell><mxCell id="chrome" value="&lt;b&gt;Chromium 121 + 合成 Odoo&lt;/b&gt;&lt;br&gt;模拟表单 / host-only SID 跨端口&lt;br&gt;内源认人、Host 与降级保护&lt;br&gt;不是实际密码或飞书认证" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="770" width="360" height="145" as="geometry"/></mxCell><mxCell id="integration" value="&lt;b&gt;整合提交仍待形成 / 复审&lt;/b&gt;&lt;br&gt;绑定单一源码 SHA、镜像与依赖&lt;br&gt;包含实际扩展 / 环境范围&lt;br&gt;混搭通过不能直接当作部署通过" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="360" height="170" as="geometry"/></mxCell><mxCell id="lc-off" value="&lt;b&gt;本试验 LC 扩展关闭&lt;/b&gt;&lt;br&gt;未证明完整 Lifecycle 扩展链&lt;br&gt;市场自有库也仍为 SQLite" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="360" height="125" as="geometry"/></mxCell><mxCell id="not-covered" value="&lt;b&gt;未覆盖项不标已验&lt;/b&gt;&lt;br&gt;真实账号 / 飞书 OAuth / 公网&lt;br&gt;工作台自身库全量迁 PG&lt;br&gt;生产切流 / 备份恢复 / 数据保全" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=12;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="770" width="360" height="145" a