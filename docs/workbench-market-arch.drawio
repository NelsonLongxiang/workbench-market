        <mxCell id="upload-token-switch" value="上传令牌开关 run_upload_require_token（缺省关=T1 直传·严格开=页面接线 X-Run-Upload-Token·#151/#152）＋MCP 网关双 env（ADMIN_TOKEN+MCP_GATEWAY·401 面）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="450" y="1380" width="320" height="60" as="geometry"/></mxCell>
