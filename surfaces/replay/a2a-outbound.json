{
  "domain": "a2a-outbound",
  "what": "A2A 出站的两条管理面：/api/a2a/state 只给管理员读；/api/a2a/send 只给管理员，且只发给对端登记表里 active 的对端。库里预先放三个对端：active、公钥待确认、已停用。response 由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /api/a2a/state", "POST /api/a2a/send"],
  "exempt": [
    { "route": "GET /api/a2a/state", "class": "invalid", "why": "不读任何参数，没有会被拒的输入", "shown_by": "open/state" },
    { "route": "POST /api/a2a/send", "class": "normal", "why": "正常发出要一个真的对端收投递：回放环境里没有。正常发出由 scripts/a2a-peers-test.mjs 起假对端来测（还测了被拒的对端一次都没收到）", "shown_by": "open/send-unregistered" }
  ],
  "scenarios": [
    {
      "name": "open",
      "what": "登录门关；管理口令由环境给合成值。远程匿名用转发头表示。定了时钟。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin" },
      "clock": "2030-01-01T00:00:00Z",
      "seed": [
        {
          "table": "a2a_peers",
          "row": { "id": "peer_aaaaaaaaaaaa", "root_url": "http://127.0.0.1:9", "zone": "team-a", "name": "a-node", "public_key": "QUFB", "key_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "card_capabilities": "{\"version\":\"1.0\"}", "card_version": "1.0", "status": "active", "registered_by": "system:migration", "registered_at": "2030-01-01T00:00:00.000Z", "updated_at": "2030-01-01T00:00:00.000Z" }
        },
        {
          "table": "a2a_peers",
          "row": { "id": "peer_bbbbbbbbbbbb", "root_url": "http://127.0.0.1:10", "zone": "team-b", "name": "b-node", "public_key": "QkJC", "key_fingerprint": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "pending_public_key": "Q0ND", "pending_fingerprint": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "status": "key_changed", "registered_by": "admin-token", "registered_at": "2030-01-01T00:00:00.000Z", "updated_at": "2030-01-01T00:00:00.000Z" }
        },
        {
