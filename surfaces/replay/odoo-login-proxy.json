            "body": { "method": "POST", "url": "/web/login", "headers": { "origin": "http://odoo.replay.test", "host": "odoo.replay.test", "accept-encoding": "identity", "content-type": "application/x-www-form-urlencoded" }, "body": "login=alice" }
          }
