        {
          "id": "submit-totp",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "normal",
          "what": "二次验证提交：一样转给 Odoo",
          "request": { "method": "POST", "path": "/web/login/totp", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded", "origin": "http://market.replay.test" }, "text": "totp_token=123456" },
          "response": {
            "status": 200,
            "type": "text/html; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-security-policy": "frame-ancestors 'none'", "referrer-policy": "strict-origin", "transfer-encoding": "chunked", "x-content-type-options": "nosniff", "x-frame-options": "DENY", "x-powered-by": "Express" },
            "body": "<form>totp</form>"
          }
        },
        {
          "id": "submit-cross-site",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "unauthorized",
          "what": "sec-fetch-site cross-site：403（同源门，不是授权结论）",
          "request": { "method": "POST", "path": "/web/login", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded", "sec-fetch-site": "cross-site" }, "text": "login=alice" },
          "response": { "status": 403, "type": "", "headers": { "content-length": "0", "x-powered-by": "Express" }, "body": "" }
        },
        {
          "id": "submit-origin-mismatch",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "unauthorized",
          "what": "Origin 的主机不是 Host：403",
          "request": { "method": "POST", "path": "/web/login", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded", "origin": "http://elsewhere.example" }, "text": "login=alice" },
          "response": { "status": 403, "type": "", "headers": { "content-length": "0", "x-powered-by": "Express" }, "body": "" }
        },
        {
          "id": "submit-origin-null",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "unauthorized",
          "what": "Origin 是 null：解析不了，403",
          "request": { "method": "POST", "path": "/web/login", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded", "origin": "null" }, "text": "login=alice" },
          "response": { "status": 403, "type": "", "headers": { "content-length": "0", "x-powered-by": "Express" }, "body": "" }
        },
        {
          "id": "submit-json",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "invalid",
          "what": "正文不是表单：415",
          "request": { "method": "POST", "path": "/web/login", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/json", "origin": "http://market.replay.test" }, "text": "{\"login\":\"alice\"}" },
          "response": { "status": 415, "type": "", "headers": { "content-length": "0", "x-powered-by": "Express" }, "body": "" }
        },
        {
          "id": "submit-too-big",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "invalid",
          "what": "正文超过 16kb：413",
          "request": {
            "method": "POST",
            "path": "/web/login",
            "raw": true,
            "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded" },
            "text": ""
          },
          "response": { "status": 413, "type": "text/plain; charset=utf-8", "headers": { "content-length": "21", "etag": "W/\"15-<指纹>\"", "x-powered-by": "Express" }, "body": "Invalid login request" }
        },
        {
          "id": "submit-too-many",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "invalid",
          "what": "参数超过 24 个：413",
          "request": {
            "method": "POST",
            "path": "/web/login",
            "raw": true,
            "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded" },
            "text": "k0=v&k1=v&k2=v&k3=v&k4=v&k5=v&k6=v&k7=v&k8=v&k9=v&k10=v&k11=v&k12=v&k13=v&k14=v&k15=v&k16=v&k17=v&k18=v&k19=v&k20=v&k21=v&k22=v&k23=v&k24=v&k25=v&k26=v&k27=v&k28=v&k29=v"
          },
          "response": { "status": 413, "type": "text/plain; charset=utf-8", "headers": { "content-length": "21", "etag": "W/\"15-<指纹>\"", "x-powered-by": "Express" }, "body": "Invalid login request" }
        },
        {
          "id": "submit-other-path",
          "what": "POST /web 下别的路径：中继不接，落到最后的 404",
          "request": { "method": "POST", "path": "/web/database/manager", "raw": true, "headers": { "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded" }, "text": "x=1" },
          "response": { "status": 404, "type": "application/json; charset=utf-8", "headers": { "content-length": "21", "etag": "W/\"15-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": { "error": "not found" } }
        }
      ]
    },
    {
      "name": "off",
      "what": "没开中继：两层放过。前端占位。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin", "WM_ODOO_URL": "http://odoo.replay.test" },
      "fixtures": ["odoo-login-fake", "web-dist-stub"],
      "steps": [
        {
          "id": "off-page",
          "route": "GET /^\\/(?:web\\/|website\\/translations$|[a-z]{2}(?:_[A-Z]{2})?\\/website\\/translations$)/",
          "class": "normal",
          "what": "没开中继：这一层放过，落到页面兜底",
          "compare": "status",
          "request": { "method": "GET", "path": "/web/login", "headers": {} },
          "response": { "status": 200 }
        },
        {
          "id": "off-submit",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "invalid",
          "what": "没开中继、POST：放过，落到最后的 404",
          "request": { "method": "POST", "path": "/web/login", "headers": { "content-type": "application/x-www-form-urlencoded" }, "text": "login=alice" },
          "response": { "status": 404, "type": "application/json; charset=utf-8", "headers": { "content-length": "21", "etag": "W/\"15-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": { "error": "not found" } }
        }
      ]
    },
    {
      "name": "gated",
      "what": "开了中继、登录门开（enforce）。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin", "WM_ODOO_LOGIN_PROXY": "1", "WM_ODOO_URL": "http://odoo.replay.test", "WM_LOGIN_GATE": "enforce" },
      "fixtures": ["odoo-login-fake"],
      "steps": [
        {
          "id": "gated-page",
          "route": "GET /^\\/(?:web\\/|website\\/translations$|[a-z]{2}(?:_[A-Z]{2})?\\/website\\/translations$)/",
          "class": "normal",
          "what": "登录门开、远程匿名：登录页本来就不用登录，照转给 Odoo",
          "request": { "method": "GET", "path": "/web/login", "headers": { "x-forwarded-for": "198.51.100.7", "accept": "text/html" } },
          "response": {
            "status": 200,
            "type": "text/html; charset=utf-8",
            "headers": {
              "cache-control": "no-store",
              "content-security-policy": "default-src 'self', frame-ancestors 'self'",
              "referrer-policy": "strict-origin",
              "set-cookie": ["session_id=replay-odoo-session-0001; HttpOnly; Path=/; SameSite=Lax"],
              "transfer-encoding": "chunked",
              "x-content-type-options": "nosniff",
              "x-frame-options": "SAMEORIGIN",
              "x-powered-by": "Express"
            },
            "body": "<!doctype html><form method=\"post\" action=\"/web/login\"><input name=\"login\"></form>"
          }
        },
        {
          "id": "gated-submit",
          "route": "POST /^\\/web\\/login(?:\\/totp)?$/",
          "class": "normal",
          "what": "登录门开、远程匿名提交登录：照转",
          "request": {
            "method": "POST",
            "path": "/web/login",
            "raw": true,
            "headers": { "x-forwarded-for": "198.51.100.7", "host": "market.replay.test", "content-type": "application/x-www-form-urlencoded", "origin": "http://market.replay.test" },
            "text": "login=alice&password=synthetic"
          },
          "response": {
            "status": 200,
            "type": "application/json",
            "headers": {
              "cache-control": "no-store",
              "content-security-policy": "frame-ancestors 'self'",
              "referrer-policy": "strict-origin",
              "set-cookie": ["session_id=replay-odoo-session-0001-new; HttpOnly; Path=/; SameSite=Lax"],
              "transfer-encoding": "chunked",
              "x-content-type-options": "nosniff",
              "x-frame-options": "SAMEORIGIN",
              "x-powered-by": "Express"
            },
            "body": {
              "method": "POST",
              "url": "/web/login",
              "headers": { "origin": "http://odoo.replay.test", "host": "odoo.replay.test", "accept-encoding": "identity", "content-type": "application/x-www-form-urlencoded" },
              "body": "login=alice&password=synthetic"
            }
          }
        },
        {
          "id": "gated-other",
          "what": "登录门开、远程匿名、中继不接的 /web 路径：登录门先挡",
          "request": { "method": "GET", "path": "/web/database/manager", "headers": { "x-forwarded-for": "198.51.100.7", "accept": "text/html" } },
          "response": {
            "status": 302,
            "type": "text/html; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "68", "location": "/login?next=%2Fweb%2Fdatabase%2Fmanager", "vary": "Accept", "x-powered-by": "Express" },
            "body": "<p>Found. Redirecting to /login?next=%2Fweb%2Fdatabase%2Fmanager</p>"
          }
        }
      ]
    }
  ]
