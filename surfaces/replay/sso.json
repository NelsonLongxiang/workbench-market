    },
    {
      "name": "gated",
      "what": "登录门开着（WM_LOGIN_GATE=enforce），管理口令由环境给（合成值，只在隔离实例里用）。没有身份的跳转请求被拦下。",
      "env": { "WM_LOGIN_GATE": "enforce", "ADMIN_TOKEN": "replay-synthetic-admin" },
      "steps": [
        {
          "id": "anonymous",
          "route": "GET /sso/callback",
          "class": "unauthorized",
          "what": "远程匿名",
          "request": { "method": "GET", "path": "/sso/callback?redirect=/go/3/&state=s3", "headers": { "x-forwarded-for": "198.51.100.7", "cookie": "wm_sso_3=s3" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "120", "etag": "W/\"78-<指纹>\"", "x-powered-by": "Express", "x-wm-login-required": "1" },
            "body": { "error": "login_required", "message": "需要登录：用 Odoo 内部账号或管理员口令登录", "login_url": "/login" }
          }
        },
        {
          "id": "wrong-token",
          "route": "GET /sso/callback",
          "class": "unauthorized",
          "what": "口令不对",
          "request": { "method": "GET", "path": "/sso/callback?redirect=/go/3/&state=s3", "headers": { "x-forwarded-for": "198.51.100.7", "x-admin-token": "not-the-token", "cookie": "wm_sso_3=s3" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "120", "etag": "W/\"78-<指纹>\"", "x-powered-by": "Express", "x-wm-login-required": "1" },
            "body": { "error": "login_required", "message": "需要登录：用 Odoo 内部账号或管理员口令登录", "login_url": "/login" }
          }
        },
        {
          "id": "browser-anonymous",
          "route": "GET /sso/callback",
          "class": "unauthorized",
          "what": "本机但带浏览器标记：不算命令行",
          "request": { "method": "GET", "path": "/sso/callback?redirect=/go/3/&state=s3", "headers": { "sec-fetch-site": "same-origin", "cookie": "wm_sso_3=s3" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "120", "etag": "W/\"78-<指纹>\"", "x-powered-by": "Express", "x-wm-login-required": "1" },
            "body": { "error": "login_required", "message": "需要登录：用 Odoo 内部账号或管理员口令登录", "login_url": "/login" }
          }
        },
        {
          "id": "with-token",
          "route": "GET /sso/callback",
          "class": "normal",
          "what": "远程带口令",
          "request": { "method": "GET", "path": "/sso/callback?redirect=/go/3/&state=s3", "headers": { "x-forwarded-for": "198.51.100.7", "x-admin-token": "replay-synthetic-admin", "cookie": "wm_sso_3=s3" } },
          "response": { "status": 302, "type": "text/plain; charset=utf-8", "headers": { "content-length": "28", "location": "/go/3/", "vary": "Origin, Accept", "x-powered-by": "Express" }, "body": "Found. Redirecting to /go/3/" }
        },
        {
          "id": "with-token-cross-site",
          "route": "GET /sso/callback",
          "class": "normal",
          "what": "口令对、浏览器从别的站点跳回来：这是读，不查同源",
