          },
          "response": { "status": 302, "type": "text/plain; charset=utf-8", "headers": { "content-length": "28", "location": "/go/3/", "vary": "Accept", "x-powered-by": "Express" }, "body": "Found. Redirecting to /go/3/" }
        },
        {
          "id": "with-token-bad-state",
          "route": "GET /sso/callback",
          "class": "invalid",
          "what": "远程带口令，state 对不上",
          "request": { "method": "GET", "path": "/sso/callback?redirect=/go/3/&state=s3", "headers": { "x-forwarded-for": "198.51.100.7", "x-admin-token": "replay-synthetic-admin", "cookie": "wm_sso_3=x" } },
          "response": { "status": 400, "type": "application/json; charset=utf-8", "headers": { "content-length": "70", "etag": "W/\"46-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": { "error": "SSO state 校验失败（请从市场门户重新进入）" } }
