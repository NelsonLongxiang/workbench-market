        {
          "id": "no-session",
          "what": "没配置身份来源：503（5xx 不算三类里的哪一类，只录下来比）",
          "request": { "method": "GET", "path": "/api/auth/viewer", "headers": {} },
          "response": {
            "status": 503,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "44", "etag": "W/\"2c-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "ok": false, "error": "未配置 WM_ODOO_URL" }
          }
        }
      ]
    },
