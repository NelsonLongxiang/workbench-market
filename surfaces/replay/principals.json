{
  "domain": "principals",
  "what": "主体管理：/api/principals 的 7 条路由。response 由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /api/principals", "POST /api/principals/disable", "POST /api/principals/restore", "POST /api/principals/bind", "POST /api/principals/unbind", "GET /api/principals/pending", "POST /api/principals/bind-batch"],
  "exempt": [
    { "route": "GET /api/principals", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入：带畸形参数的请求照常应答", "shown_by": "open/list-junk-query" },
    { "route": "GET /api/principals/pending", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入", "shown_by": "open/pending" }
  ],
