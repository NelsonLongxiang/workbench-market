      "env": {},
      "seed": [
        { "table": "principals", "row": { "id": "user:synthetic-a", "id_key": "user:synthetic-a", "kind": "person", "display_name": "Synthetic A" } },
        { "table": "principal_identities", "row": { "provider": "odoo", "external_id": "synthetic-a", "external_key": "synthetic-a", "principal_id": "user:synthetic-a" } },
        { "table": "principals", "row": { "id": "seat:synthetic-seat", "id_key": "seat:synthetic-seat", "kind": "seat", "owner": "user:synthetic-a" } }
      ],
      "steps": [
        {
          "id": "list-remote-anon",
          "route": "GET /api/principals",
          "class": "unauthorized",
          "what": "远程、没有口令：列不出",
          "request": { "method": "GET", "path": "/api/principals", "headers": { "x-forwarded-for": "192.0.2.10" } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "141", "etag": "W/\"8d-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "需要有效的 X-Admin-Token 或 Odoo 管理员登录（口令缺失或无效一律拒绝；顶栏钥匙图标可输入口令）" }
          }
        },
        {
          "id": "list-cli",
