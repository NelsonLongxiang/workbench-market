{
  "domain": "principals",
  "what": "主体管理：/api/principals 的 3 条路由。response 由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /api/principals", "POST /api/principals/disable", "POST /api/principals/restore"],
  "exempt": [{ "route": "GET /api/principals", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入：带畸形参数的请求照常应答", "shown_by": "open/list-junk-query" }],
  "scenarios": [
    {
      "name": "open",
      "what": "缺省配置：登录门关，没设管理口令，没配身份来源。本机命令行（回环直连、不带浏览器标记和转发头）算管理员；带转发头的按远程处理，没有口令就不是管理员。库里预先放两个主体。",
      "env": {},
      "seed": [
        { "table": "principals", "row": { "id": "user:synthetic-a", "kind": "person", "display_name": "Synthetic A" } },
        { "table": "principal_identities", "row": { "provider": "odoo", "external_id": "synthetic-a", "principal_id": "user:synthetic-a" } },
        { "table": "principals", "row": { "id": "seat:synthetic-seat", "kind": "seat", "owner": "user:synthetic-a" } }
      ],
      "steps": [
        {
          "id": "list-remote-anon",
          "route": "GET /api/principals",
          "class": "unauthorized",
          "what": "远程、没有口令：列不出",
          "request": { "method": "GET", "path": "/api/principals", "headers": { "x-forwarded-for": "192.0.2.10" } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "141", "etag": "W/\"8d-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "需要有效的 X-Admin-Token 或 Odoo 管理员登录（口令缺失或无效一律拒绝；顶栏钥匙图标可输入口令）" }
          }
        },
        {
          "id": "list-cli",
          "route": "GET /api/principals",
          "class": "normal",
          "what": "本机命令行：列出全部主体和外部身份",
          "compare": "status",
          "request": { "method": "GET", "path": "/api/principals" },
          "response": { "status": 200 }
        },
        {
          "id": "list-junk-query",
          "route": "GET /api/principals",
          "class": "normal",
          "what": "带畸形查询串照常应答",
          "compare": "status",
          "request": { "method": "GET", "path": "/api/principals?id=%00&x[]=1" },
          "response": { "status": 200 }
        },
        {
          "id": "disable-remote-anon",
          "route": "POST /api/principals/disable",
          "class": "unauthorized",
          "what": "远程、没有口令：停用不了",
          "request": { "method": "POST", "path": "/api/principals/disable", "headers": { "x-forwarded-for": "192.0.2.10" }, "json": { "id": "user:synthetic-a" } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "content-length": "141", "etag": "W/\"8d-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "需要有效的 X-Admin-Token 或 Odoo 管理员登录（口令缺失或无效一律拒绝；顶栏钥匙图标可输入口令）" }
          }
        },
        {
          "id": "disable-cross-site",
