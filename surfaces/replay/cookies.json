      "env": {},
      "clock": "2030-01-01T00:00:00Z",
      "steps": [
        {
          "id": "list-empty",
          "route": "GET /api/cookies",
          "class": "normal",
          "what": "新库里没有 Cookie 池",
          "request": { "method": "GET", "path": "/api/cookies" },
          "response": { "status": 200, "type": "application/json; charset=utf-8", "headers": { "content-length": "2", "etag": "W/\"2-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": [] }
        },
        {
          "id": "list-junk-query",
          "route": "GET /api/cookies",
          "class": "normal",
          "what": "这条路由不读查询串：带无关、畸形的参数照常应答",
          "request": { "method": "GET", "path": "/api/cookies?limit=abc&id=-1&label[]=x" },
          "response": { "status": 200, "type": "application/json; charset=utf-8", "headers": { "content-length": "2", "etag": "W/\"2-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": [] }
        },
        {
          "id": "list-head",
          "what": "HEAD 走同一条 GET 路由，没有响应体",
          "request": { "method": "HEAD", "path": "/api/cookies" },
          "response": { "status": 200, "type": "application/json; charset=utf-8", "headers": { "content-length": "2", "etag": "W/\"2-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": "" }
        },
        {
          "id": "create-remote-anonymous",
          "route": "POST /api/cookies",
          "class": "unauthorized",
          "what": "带转发头、没有口令的写",
          "request": { "method": "POST", "path": "/api/cookies", "headers": { "x-forwarded-for": "198.51.100.7" }, "json": { "label": "不该建出来", "cookies": [{ "name": "sid", "value": "synthetic-value" }] } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "content-length": "141", "etag": "W/\"8d-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "需要有效的 X-Admin-Token 或 Odoo 管理员登录（口令缺失或无效一律拒绝；顶栏钥匙图标可输入口令）" }
