{
  "domain": "cookies",
  "what": "Cookie 池：/api/cookies 的 3 条路由。response 是搬之前录下来的，由 scripts/route-replay-test.mjs --record 写入，不手改。请求里的 cookie 值都是合成的。",
  "routes": ["GET /api/cookies", "POST /api/cookies", "DELETE /api/cookies/:id"],
  "exempt": [{ "route": "GET /api/cookies", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入：带畸形参数的请求照常应答", "shown_by": "open/list-junk-query" }],
