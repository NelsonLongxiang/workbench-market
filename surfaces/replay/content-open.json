{
  "domain": "content-open",
  "what": "市场面上内容面的两层（随内容面配置才有用）：启动页 /content/open/<目标号>（从可信入口、带认得的会话，出一页按钮去内容面），迁移跳转（开了迁移的目标，浏览器顶层导航到 /go/<号>/… 时送去启动页）。没配内容面时两层都放过。2 条路由。response 是搬之前录下来的，由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["ALL /^\\/content\\/open\\//", "GET /^\\/go\\/([1-9][0-9]*)(?:\\/|$)/i"],
  "exempt": [{ "route": "GET /^\\/go\\/([1-9][0-9]*)(?:\\/|$)/i", "class": "unauthorized", "why": "迁移跳转只管把浏览器送到可信入口，不认人；认人在启动页", "shown_by": "configured/mig-nav" }],
  "scenarios": [
    {
      "name": "configured",
      "what": "配了内容面（content-surface-fake 夹具：端口现找、市场入口 http://market.replay.test、2 号目标开迁移、3 号不开），登录方换成假的，前端占位。登录门关。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin" },
      "fixtures": ["content-surface-fake", "identity-fake", "web-dist-stub"],
      "steps": [
        {
          "id": "open-ok",
          "route": "ALL /^\\/content\\/open\\//",
          "class": "normal",
          "what": "从可信入口（Host 是市场入口）、带一个认得的会话：200 启动页（表单地址带内容面的端口、票据每次随机，只比状态码）",
          "compare": "status",
          "request": { "method": "GET", "path": "/content/open/2", "raw": true, "headers": { "host": "market.replay.test", "cookie": "session_id=fake-internal-alpha-0001" } },
          "response": { "status": 200 }
        },
        {
          "id": "open-head",
          "route": "ALL /^\\/content\\/open\\//",
          "class": "normal",
          "what": "HEAD 一样：200（只比状态码）",
          "compare": "status",
          "request": { "method": "HEAD", "path": "/content/open/2", "raw": true, "headers": { "host": "market.replay.test", "cookie": "session_id=fake-internal-alpha-0001" } },
          "response": { "status": 200 }
        },
        {
          "id": "open-anon",
          "route": "ALL /^\\/content\\/open\\//",
          "class": "unauthorized",
          "what": "没有会话：401 请先登录",
          "request": { "method": "GET", "path": "/content/open/2", "raw": true, "headers": { "host": "market.replay.test" } },
          "response": {
            "status": 401,
            "type": "text/html; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "207", "content-security-policy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'", "etag": "W/\"cf-<指纹>\"", "referrer-policy": "no-referrer", "x-content-type-options": "nosniff", "x-powered-by": "Express" },
