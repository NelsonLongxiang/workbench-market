{
  "domain": "a2a-roster",
  "what": "团队名册的读：GET /api/a2a/teams（登录即可读，只有席位信息）。response 由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /api/a2a/teams"],
  "exempt": [{ "route": "GET /api/a2a/teams", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入：带畸形参数的请求照常应答", "shown_by": "admin/junk-query" }],
  "scenarios": [
    {
      "name": "admin",
      "what": "管理口令由环境给（合成值，只在隔离实例里用）；库里先放一台宿主的名册。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin" },
      "seed": [
        {
          "table": "a2a_rosters",
          "row": { "host": "abcdef0123456789", "peer_root": "http://peer.synthetic.invalid", "peer_zone": "lab", "reported_at": "2026-11-11T09:00:00.000Z", "received_at": "2026-11-11 09:00:01.000", "seats": "[{\"seat\": \"lab/a1a1a1a1\", \"name\": \"成员甲\", \"team\": \"lab/canvas/team\", \"role\": \"member\", \"online\": true, \"queued\": 0, \"last_active_at\": \"\"}, {\"seat\": \"lab/00000000\", \"name\": \"总工\", \"team\": \"lab/canvas/team\", \"role\": \"router\", \"online\": false, \"queued\": 0, \"last_active_at\": \"\"}]" }
        }
      ],
      "steps": [
        {
          "id": "admin",
          "route": "GET /api/a2a/teams",
          "class": "normal",
          "what": "管理员：列出团队与席位，在岗数、在办件数",
          "request": { "method": "GET", "path": "/api/a2a/teams", "headers": { "sec-fetch-site": "same-origin", "x-admin-token": "replay-synthetic-admin" } },
          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "432", "etag": "W/\"1b0-<指纹>\"", "vary": "Origin, Cookie, X-Admin-Token", "x-powered-by": "Express" },
            "body": {
              "teams": [
                {
                  "team": "lab/canvas/team",
                  "name": "team",
                  "host": "abcdef0123456789",
                  "peer_zone": "lab",
                  "reported_at": "YYYY-MM-DDThh:mm:ss.fffZ",
                  "received_at": "YYYY-MM-DD hh:mm:ss.fff",
                  "seats": [
                    { "seat": "lab/a1a1a1a1", "name": "成员甲", "role": "member", "online": true, "active": 0, "queued": 0, "last_active_at": "" },
                    { "seat": "lab/00000000", "name": "总工", "role": "router", "online": false, "active": 0, "queued": 0, "last_active_at": "" }
                  ],
                  "seats_online": 1
                }
              ]
            }
          }
        },
        {
          "id": "junk-query",
          "route": "GET /api/a2a/teams",
          "class": "normal",
          "what": "带畸形查询串照常应答（这条路由不读查询串）",
          "request": { "method": "GET", "path": "/api/a2a/teams?team=x&a[]=b", "headers": { "sec-fetch-site": "same-origin", "x-admin-token": "replay-synthetic-admin" } },
          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "432", "etag": "W/\"1b0-<指纹>\"", "vary": "Origin, Cookie, X-Admin-Token", "x-powered-by": "Express" },
            "body": {
              "teams": [
                {
                  "team": "lab/canvas/team",
                  "name": "team",
                  "host": "abcdef0123456789",
                  "peer_zone": "lab",
                  "reported_at": "YYYY-MM-DDThh:mm:ss.fffZ",
                  "received_at": "YYYY-MM-DD hh:mm:ss.fff",
                  "seats": [
                    { "seat": "lab/a1a1a1a1", "name": "成员甲", "role": "member", "online": true, "active": 0, "queued": 0, "last_active_at": "" },
                    { "seat": "lab/00000000", "name": "总工", "role": "router", "online": false, "active": 0, "queued": 0, "last_active_at": "" }
                  ],
                  "seats_online": 1
                }
              ]
            }
          }
        },
        {
          "id": "anonymous",
          "route": "GET /api/a2a/teams",
          "class": "unauthorized",
          "what": "远程匿名：401",
          "request": { "method": "GET", "path": "/api/a2a/teams", "headers": { "x-forwarded-for": "198.51.100.7" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "31", "etag": "W/\"1f-<指纹>\"", "vary": "Origin, Cookie, X-Admin-Token", "x-powered-by": "Express" },
            "body": { "error": "teams_auth_required" }
          }
        },
        {
          "id": "bad-token",
          "route": "GET /api/a2a/teams",
          "class": "unauthorized",
          "what": "口令不对、没有会话：401",
          "request": { "method": "GET", "path": "/api/a2a/teams", "headers": { "sec-fetch-site": "same-origin", "x-admin-token": "wrong" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "31", "etag": "W/\"1f-<指纹>\"", "vary": "Origin, Cookie, X-Admin-Token", "x-powered-by": "Express" },
            "body": { "error": "teams_auth_required" }
          }
        },
        {
          "id": "cross-site",
          "route": "GET /api/a2a/teams",
          "class": "unauthorized",
          "what": "跨站：403",
          "request": { "method": "GET", "path": "/api/a2a/teams", "headers": { "sec-fetch-site": "cross-site", "x-admin-token": "replay-synthetic-admin" } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "37", "etag": "W/\"25-<指纹>\"", "vary": "Origin, Cookie, X-Admin-Token", "x-powered-by": "Express" },
            "body": { "error": "teams_cross_origin_denied" }
          }
        }
      ]
    }
  ]
}
