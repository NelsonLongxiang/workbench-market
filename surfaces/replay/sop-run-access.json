  "exempt": [{ "route": "POST /api/sop/runs/:id(\\d+)/read-caps/revoke", "class": "invalid", "why": "撤销全部读能力不读请求体，也不查 run 在不在（没有这个 run 照样回 0）", "shown_by": "open/cap-revoke-missing-run" }],
