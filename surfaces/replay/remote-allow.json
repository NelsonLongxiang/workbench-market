{
  "domain": "remote-allow",
  "what": "远程写豁免面的变更：GET /api/remote-allow/diff 这一条路由，只给管理员。回启动时算的那一份变更（added、removed、current）和库里快照的条数。response 是搬之前录下来的，由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /api/remote-allow/diff"],
  "exempt": [{ "route": "GET /api/remote-allow/diff", "class": "invalid", "why": "不读请求里的任何东西", "shown_by": "open/diff" }],
