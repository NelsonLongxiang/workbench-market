      "env": { "ADMIN_TOKEN": "replay-synthetic-admin" },
      "clock": "2030-01-01T00:00:00Z",
      "seed": [{ "table": "remote_allow_state", "row": { "snapshot": "[\"POST /api/old-a\"]" } }, { "table": "remote_allow_state", "row": { "snapshot": "[\"POST /api/old-a\",\"POST /api/old-b\"]" } }],
