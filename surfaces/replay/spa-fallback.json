            "headers": { "cache-control": "no-cache", "content-length": "244", "etag": "W/\"f4-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": "<!doctype html>\n<html><head><meta name=\"wm-surface\" content=\"market\"><meta name=\"wm-control-url\" content=\"\"><meta name=\"wm-market-url\" content=\"http://127.0.0.1:<市场端口>\"><title>占位前端</title></head><body><div id=\"root\"></div></body></html>\n"
