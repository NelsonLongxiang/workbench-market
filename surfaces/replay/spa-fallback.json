    {
      "name": "gated",
      "what": "登录门开（enforce），前端目录是占位；登录用 identity-fake。",
      "env": { "WM_LOGIN_GATE": "enforce" },
      "fixtures": ["web-dist-stub", "identity-fake"],
      "steps": [
        {
          "id": "gated-anon",
          "what": "登录门开：没有身份的页面请求在登录门就 302 到 /login，到不了兜底",
          "request": { "method": "GET", "path": "/market/manage", "headers": { "x-forwarded-for": "198.51.100.7", "accept": "text/html" } },
          "response": {
            "status": 302,
            "type": "text/html; charset=utf-8",
            "headers": { "cache-control": "no-store", "content-length": "59", "location": "/login?next=%2Fmarket%2Fmanage", "vary": "Accept", "x-powered-by": "Express" },
            "body": "<p>Found. Redirecting to /login?next=%2Fmarket%2Fmanage</p>"
          }
        },
