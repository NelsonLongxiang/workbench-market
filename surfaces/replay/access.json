{
  "domain": "access",
  "what": "角色预设 ②：以某人的身份看、红线清单、首次安装向导的 5 条路由。response 由 scripts/route-replay-test.mjs --record 写入，不手改。人都是合成的。",
  "routes": ["GET /api/principals/:id/access", "GET /api/access/red-lines", "GET /api/setup/wizard", "POST /api/setup/wizard", "POST /api/setup/wizard/approve"],
  "exempt": [
    { "route": "GET /api/access/red-lines", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入", "shown_by": "open/redlines-junk" },
    { "route": "GET /api/setup/wizard", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入", "shown_by": "open/wizard-read-empty" }
  ],
  "scenarios": [
    {
      "name": "open",
      "what": "缺省配置：登录门关，没设管理口令。本机命令行算管理员也是属主；假登录提供方认出 alpha、beta（都不是管理员）。定了时钟：向导运行的时间按分钟取整再比。",
      "env": {},
      "clock": "2030-01-01T00:00:00Z",
      "fixtures": ["identity-fake"],
      "seed": [
        { "table": "principals", "row": { "id": "user:alpha", "id_key": "user:alpha", "kind": "person", "display_name": "合成甲" } },
        { "table": "principals", "row": { "id": "user:beta", "id_key": "user:beta", "kind": "person", "display_name": "合成乙" } },
        { "table": "principal_identities", "row": { "provider": "fake", "external_id": "alpha", "external_key": "alpha", "principal_id": "user:alpha" } },
        { "table": "principal_identities", "row": { "provider": "fake", "external_id": "beta", "external_key": "beta", "principal_id": "user:beta" } }
      ],
      "steps": [
        {
          "id": "access-cli",
          "route": "GET /api/principals/:id/access",
          "class": "normal",
          "what": "本机命令行看 alpha：还没有任何授予",
          "request": { "method": "GET", "path": "/api/principals/user:alpha/access" },
          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "120", "etag": "W/\"78-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "principal": { "id": "user:alpha", "kind": "person", "status": "active", "display_name": "合成甲" }, "active": [], "inactive": [] }
          }
        },
        {
          "id": "access-remote-anon",
          "route": "GET /api/principals/:id/access",
          "class": "unauthorized",
          "what": "远程、没登录：401",
          "request": { "method": "GET", "path": "/api/principals/user:alpha/access", "headers": { "x-forwarded-for": "192.0.2.10" } },
          "response": {
            "status": 401,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "32", "etag": "W/\"20-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "access_auth_required" }
          }
        },
        {
          "id": "access-other",
          "route": "GET /api/principals/:id/access",
          "class": "unauthorized",
          "what": "员工 beta 看 alpha：403",
          "request": { "method": "GET", "path": "/api/principals/user:alpha/access", "headers": { "sec-fetch-site": "same-origin", "cookie": "session_id=fake-internal-beta-00001" } },
          "response": {
            "status": 403,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "85", "etag": "W/\"55-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "access_not_self", "message": "只能看自己的；看别人的要管理员" }
          }
        },
        {
          "id": "access-bad-id",
          "route": "GET /api/principals/:id/access",
          "class": "invalid",
          "what": "主体标识写法不对：400",
          "request": { "method": "GET", "path": "/api/principals/nobody/access" },
          "response": {
            "status": 400,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "95", "etag": "W/\"5f-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "主体标识写法不对（形如 user:<登录名>）", "code": "principal_id_invalid" }
          }
        },
        {
          "id": "access-missing",
          "route": "GET /api/principals/:id/access",
          "class": "invalid",
          "what": "主体不存在：404",
          "request": { "method": "GET", "path": "/api/principals/user:nobody/access" },
          "response": {
            "status": 404,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "70", "etag": "W/\"46-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "principal_missing", "message": "主体 user:nobody 不存在" }
          }
        },
        {
          "id": "access-bad-action",
          "route": "GET /api/principals/:id/access",
          "class": "invalid",
          "what": "action 写法不对：400",
          "request": { "method": "GET", "path": "/api/principals/user:alpha/access?action=BAD!" },
          "response": {
            "status": 400,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "55", "etag": "W/\"37-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "error": "action 写法不对", "code": "action_invalid" }
          }
        },
        {
          "id": "redlines",
          "route": "GET /api/access/red-lines",
          "class": "normal",
          "what": "本机命令行读红线清单",
          "request": { "method": "GET", "path": "/api/access/red-lines" },
          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "cache-control": "private, no-store", "content-length": "4393", "etag": "W/\"1129-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": {
              "red_lines": [
                { "id": "no-self-grant", "title": "不能给自己授予", "detail": "起草、提交、放行的人都不能是被授予的主体；库里也有约束。", "enforced_in": "server/src/services/grant.ts、server/src/db.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "owner-approves-admin-grants", "title": "管理员级的授予只有属主能放行", "detail": "属主、系统管理员，或者权限里带管理类的角色；口令管理员、不是属主的管理员都放行不了。", "enforced_in": "server/src/services/grant.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "decide-person-only", "title": "决定只认人", "detail": "带决定类权限的角色不授予给不是人的主体（席位、AI 员工、系统）；不是人的做决定一律转成先问人。", "enforced_in": "server/src/services/grant.ts、server/src/judgment.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "non-person-needs-responsible", "title": "不是人的主体要有在职的责任人", "detail": "席位、AI 员工这类主体，责任人不存在或停用了就不能被授予。", "enforced_in": "server/src/services/grant.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "guest-needs-expiry", "title": "访客的授予必须有期限", "detail": "没写期限的访客授予起草不了。", "enforced_in": "server/src/services/grant.ts", "test": "scripts/role-presets-test.mjs" },
                { "id": "ai-staff-non-person-only", "title": "AI 员工这个角色只授予不是人的主体", "detail": "给人授 AI 员工会被拒；人要的权限用别的预设。", "enforced_in": "server/src/services/grant.ts", "test": "scripts/role-presets-test.mjs" },
                { "id": "ai-copies-no-decide", "title": "从 AI 员工复制出来的角色不能带决定类权限", "detail": "复制几层都算（沿来源链判），删掉中间一层也不断。", "enforced_in": "server/src/routes/grants.ts、server/src/services/custom-role.ts", "test": "scripts/custom-roles-smoke.mjs" },
                { "id": "custom-roles-owner-approval", "title": "带来管理类或决定类权限的自定义角色要属主放行", "detail": "建的先待核，改的先记成提议；放行之前不能授予。", "enforced_in": "server/src/routes/grants.ts", "test": "scripts/custom-roles-smoke.mjs" },
                { "id": "business-roles-owner-approval", "title": "碰业务的自定义角色要属主放行", "detail": "系统管理员缺省看不到业务数据，也不能自己复制、改出一个带业务权限的角色转给别人：建的先待核、改的先记成提议，属主放行之前不生效。", "enforced_in": "server/src/routes/grants.ts、server/src/roles.ts", "test": "scripts/custom-roles-smoke.mjs" },
                { "id": "business-grants-business-approval", "title": "带业务写的授予要管理层或属主放行", "detail": "角色带业务域的写、不带业务拍板（部门成员、AI 员工这类），授给人或席位要管理层或属主放行；管理口令、只有系统管理员身份的放行不了，起草的人也不能自己放行。普通员工、访客照旧由系统管理员一步完成。", "enforced_in": "server/src/services/grant.ts、server/src/roles.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "business-decide-grants-owner-approval", "title": "带业务拍板的授予只有属主能放行", "detail": "管理层、部门负责人这类带业务拍板的角色，不论范围，授予只有属主能放行：管理层不能自己再造管理层，管理口令也不行。", "enforced_in": "server/src/services/grant.ts、server/src/roles.ts", "test": "scripts/grants-smoke.mjs" },
                { "id": "system-admin-no-business", "title": "系统管理员缺省看不到业务数据", "detail": "系统管理员只有系统域的读写管，业务域（事项、工作台数据、关注……）要另外授予。", "enforced_in": "server/src/roles.ts", "test": "scripts/role-presets-test.mjs" },
                { "id": "settings-no-secret-values", "title": "设置的出口不带凭据类的值", "detail": "设置读、导出、改设置的应答里，令牌、密码、密钥只说有没有；启动时自检，漏了拒绝启动。", "enforced_in": "server/src/settings-view.ts、server/src/index.ts", "test": "scripts/settings-read-smoke.mjs" },
                { "id": "export-reveal-admin-only", "title": "导出真值只给管理员", "detail": "带 reveal 的导出要管理口令或管理员登录（浏览器来的要同源）；不满足 403，不降级成掩码。", "enforced_in": "server/src/routes/export-import.ts", "test": "scripts/export-reveal-smoke.mjs" }
              ]
            }
          }
        },
