{
  "domain": "admin-token",
  "what": "管理口令：/api/admin/whoami 和 /api/admin-token 的 4 条路由（查自己是不是管理员、口令状态、设置、清除）。response 是搬之前录下来的，由 scripts/route-replay-test.mjs --record 写入，不手改。口令都是合成的；库里只存加盐哈希，任何应答里都没有。",
  "routes": ["GET /api/admin/whoami", "GET /api/admin-token/state", "PUT /api/admin-token", "DELETE /api/admin-token"],
  "exempt": [
    { "route": "GET /api/admin/whoami", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体；口令不对只是回「不是管理员」，没有会被拒的输入", "shown_by": "open/whoami-junk-query" },
    { "route": "GET /api/admin-token/state", "class": "invalid", "why": "这条路由不读查询串、路径参数和请求体，没有会被拒的输入", "shown_by": "open/state-fresh-local" }
  ],
  "scenarios": [
    {
      "name": "open",
      "what": "缺省配置：登录门关，环境没给口令。走一遍首次设置、改、清。",
      "env": {},
      "steps": [
        {
          "id": "state-fresh-local",
          "route": "GET /api/admin-token/state",
          "class": "normal",
          "what": "新库、本机：口令来源是「没有」，本机可以首次设置",
          "request": { "method": "GET", "path": "/api/admin-token/state" },
          "response": { "status": 200, "type": "application/json; charset=utf-8", "headers": { "content-length": "33", "etag": "W/\"21-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": { "source": "none", "settable": true } }
        },
        {
          "id": "state-fresh-remote",
          "route": "GET /api/admin-token/state",
          "class": "normal",
          "what": "新库、远程：不能首次设置",
          "request": { "method": "GET", "path": "/api/admin-token/state", "headers": { "x-forwarded-for": "198.51.100.7" } },
          "response": { "status": 200, "type": "application/json; charset=utf-8", "headers": { "content-length": "34", "etag": "W/\"22-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" }, "body": { "source": "none", "settable": false } }
        },
