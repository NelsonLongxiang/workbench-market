{
  "domain": "apps-static",
  "what": "自产台静态托管 GET /apps/<slug>/…：按活跃版本（或 ?version=N）出物化目录里的文件，CSP sandbox；HTML 注入本台令牌；目录不在时按 commit 从 LayerFS 冷回读。1 条路由（处理函数 serveApp 门户也用，留在 index.ts）。response 是搬之前录下来的，由 scripts/route-replay-test.mjs --record 写入，不手改。",
  "routes": ["GET /^\\/apps\\/[a-z0-9][a-z0-9-]*(\\/.*)?$/"],
  "scenarios": [
    {
      "name": "open",
      "what": "登录门关，不配 LayerFS。预先写进库一个自产台（活跃 v2；v1、v2 放好物化目录，v3 只有库里一行），台令牌每个实例随机（HTML 里的 hex64 换占位）。",
      "env": { "ADMIN_TOKEN": "replay-synthetic-admin" },
