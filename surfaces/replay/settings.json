          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "content-length": "232", "etag": "W/\"e8-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "health_interval_seconds": "120", "health_timeout_ms": "3000", "health_concurrency": "null", "patrol_armed_at": "YYYY-MM-DDThh:mm:ss.fffZ", "dispatch_sorting_enabled": "[object Object]", "run_upload_require_token": "false", "mcp_upstreams": "" }
