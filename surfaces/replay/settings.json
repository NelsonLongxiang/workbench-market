            "path": "/api/settings",
            "json": { "mcp_upstreams": "[{\"name\":\"up-a\",\"url\":\"http://127.0.0.1:9/mcp\",\"headers\":{\"Authorization\":\"Bearer synthetic-secret\",\"X-Extra\":\"v\"}},{\"name\":\"up-b\",\"url\":\"http://127.0.0.1:9/mcp2\"},{\"name\":\"up-c\",\"url\":\"http://127.0.0.1:9/mcp3\",\"headers\":\"not-an-object\"}]" }
