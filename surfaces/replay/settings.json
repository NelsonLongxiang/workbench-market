          "response": {
            "status": 200,
            "type": "application/json; charset=utf-8",
            "headers": { "content-length": "492", "etag": "W/\"1ec-<指纹>\"", "vary": "Origin", "x-powered-by": "Express" },
            "body": { "health_interval_seconds": "120", "health_timeout_ms": "3000", "health_concurrency": "null", "patrol_armed_at": "YYYY-MM-DDThh:mm:ss.fffZ", "dispatch_sorting_enabled": "[object Object]", "run_upload_require_token": "false", "mcp_upstreams": "[{\"name\":\"up-a\",\"url\":\"http://127.0.0.1:9/mcp\",\"headers\":{\"Authorization\":\"****\",\"X-Extra\":\"****\"}},{\"name\":\"up-b\",\"url\":\"http://127.0.0.1:9/mcp2\",\"headers\":{}},{\"name\":\"up-c\",\"url\":\"http://127.0.0.1:9/mcp3\",\"headers\":{}}]" }
          }
        },
