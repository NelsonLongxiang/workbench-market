# #215: market context + named layerfs context including its .git objects.
# Build via compose --profile layerfs build layerfs; do not use the legacy base-image wrapper.
ARG LAYERFS_COMMIT=9f97a7ec95b662e9cb288704afa165feff132cfa
FROM rust:1.85.1-bookworm AS engine
ARG LAYERFS_COMMIT
COPY --from=layerfs . /src
RUN git -c safe.directory=/src -C /src checkout --detach "$LAYERFS_COMMIT"  && test "$(git -c safe.directory=/src -C /src rev-parse HEAD)" = "$LAYERFS_COMMIT"
WORKDIR /src/core
RUN cargo build --release --locked -p layerfs-node  && cp target/release/liblayerfs_node.so /out-layerfs.node

FROM node:22-bookworm-slim
ARG LAYERFS_COMMIT
LABEL org.layerfs.commit=$LAYERFS_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl  && rm -rf /var/lib/apt/lists/*
COPY --from=engine /out-layerfs.node /usr/local/lib/layerfs.node
COPY --from=engine /src/api/agent/sdk /usr/local/lib/node_modules/@layerfs/agent
COPY deploy/layerfs-svc.mjs /usr/local/lib/layerfs-svc.mjs
ENV LAYERFS_NATIVE=/usr/local/lib/layerfs.node
ENV LAYERFS_HOME=/var/lib/layerfs/home
ENV LAYERFS_STORE_PATH=/var/lib/layerfs/home/global/store.sqlite
ENV LAYERFS_STORE_ROOT=/var/lib/layerfs
ENV LAYERFS_SERVICE_PORT=8067
VOLUME /var/lib/layerfs
EXPOSE 8067
ENTRYPOINT ["node", "/usr/local/lib/layerfs-svc.mjs"]
