# #215 final 段：context=market 仓库——COPY 真适配器 svc（base 段产物经 --from）
FROM wm-x-layerfs:base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/layerfs-svc.mjs /usr/local/lib/layerfs-svc.mjs
ENV LAYERFS_STORE_ROOT=/var/lib/layerfs
ENV LAYERFS_SERVICE_PORT=8067
ENV LAYERFS_AGENT_PATH=/usr/local/lib/layerfs-api/agent/sdk/src/index.js
ENV NODE_PATH=/usr/local/lib/layerfs-api/agent/sdk/node_modules
VOLUME /var/lib/layerfs
EXPOSE 8067
ENTRYPOINT ["node", "/usr/local/lib/layerfs-svc.mjs"]